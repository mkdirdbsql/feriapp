<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación FeriApp basado en Material3 -->
    <style name="Base.Theme.FeriApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/color_fondo</item>
        <item name="colorSecondary">@color/color_secundario</item>
        <item name="colorOnSecondary">@color/color_fondo</item>
        <item name="android:colorBackground">@color/color_fondo</item>
        <item name="colorOnBackground">@color/color_texto</item>
        <item name="colorSurface">@color/color_fondo</item>
        <item name="colorOnSurface">@color/color_texto</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_fondo</item>
    </style>
</resources>
