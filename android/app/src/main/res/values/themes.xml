<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación FeriApp basado en Material3 -->
    <style name="Base.Theme.FeriApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/color_fondo</item>
        <item name="colorSecondary">@color/color_secundario</item>
        <item name="colorOnSecondary">@color/color_fondo</item>
        <item name="android:colorBackground">@color/color_fondo</item>
        <item name="colorOnBackground">@color/color_texto</item>
        <item name="colorSurface">@color/color_fondo</item>
        <item name="colorOnSurface">@color/color_texto</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_fondo</item>
    </style>

    <style name="Theme.FeriApp" parent="Base.Theme.FeriApp" />

    <!-- Estilos reutilizables para componentes de la interfaz -->
    <style name="estilo_boton_principal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/color_primario</item>
        <item name="android:textColor">@color/color_fondo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="estilo_campo_texto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/color_primario</item>
        <item name="hintTextColor">@color/color_primario</item>
    </style>

    <style name="estilo_titulo">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto</item>
    </style>
</resources>
