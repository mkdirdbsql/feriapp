<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.consumidor.FragmentoInicioConsumidor">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- BARRA SUPERIOR (BÚSQUEDA Y FLECHA VOLVER) -->
        <LinearLayout
            android:id="@+id/layoutBarraSuperior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnVolverBusqueda"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/descripcion_volver"
                android:src="@drawable/ic_flecha_atras"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBarraBusqueda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/descripcion_lupa"
                        android:src="@drawable/ic_lupa" />

                    <EditText
                        android:id="@+id/etBuscarProducto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/buscar_producto"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_texto"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnLimpiarBusqueda"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/descripcion_limpiar_busqueda"
                        android:src="@drawable/ic_limpiar_texto"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- MAPA (CENTRO) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/contenedorMapa"
            android:name="com.feriapp.app.ui.common.FragmentoMapa"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBarraSuperior" />

        <!-- INDICADOR CARGANDO PUESTOS -->
        <ProgressBar
            android:id="@+id/indicadorCargandoPuestos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/contenedorMapa"
            app:layout_constraintEnd_toEndOf="@id/contenedorMapa"
            app:layout_constraintStart_toStartOf="@id/contenedorMapa"
            app:layout_constraintTop_toTopOf="@id/contenedorMapa" />

        <!-- CAPA OSCURA SEMITRANSPARENTE (MODO BÚSQUEDA) -->
        <View
            android:id="@+id/capaOscuraBusqueda"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBarraSuperior" />

        <!-- PANEL DE BÚSQUEDA (CATEGORÍAS / SUGERENCIAS) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelBusqueda"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBarraSuperior"
            app:layout_constraintVertical_bias="0.0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- SCROLLVIEW DE CATEGORÍAS -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:id="@+id/contenedorCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/estilo_titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/titulo_categorias"
                            android:textSize="18sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupCategorias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacing="8dp"
                            app:singleLine="false" />

                        <!-- AVISO SIN COINCIDENCIAS -->
                        <TextView
                            android:id="@+id/tvSinCoincidencias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/sin_coincidencias_busqueda"
                            android:textColor="@color/color_error"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <!-- CONTENEDOR SUGERENCIAS -->
                        <LinearLayout
                            android:id="@+id/contenedorSugerencias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvSugerencias"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PANEL DE DETALLE (PRODUCTO / PUESTO) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelDetalle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBarraSuperior">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- CABECERA: TÍTULO Y CERRAR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTituloDetalle"
                            style="@style/estilo_titulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="20sp"
                            tools:text="Ropa de Varón" />

                        <ImageButton
                            android:id="@+id/btnCerrarDetalle"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/descripcion_cerrar"
                            android:src="@drawable/ic_cerrar" />
                    </LinearLayout>

                    <!-- SECCIÓN FOTOS CON FLECHAS -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/imgFotoDetalle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/descripcion_imagen_puesto"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_puesto_placeholder" />

                        <ImageButton
                            android:id="@+id/btnFotoAnterior"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/descripcion_foto_anterior"
                            android:src="@drawable/ic_flecha_izquierda"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/btnFotoSiguiente"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/descripcion_foto_siguiente"
                            android:src="@drawable/ic_flecha_derecha"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <!-- NOMBRE PRODUCTO (MODO VECINO / PRODUCTOS DE PUESTO) -->
                    <TextView
                        android:id="@+id/tvNombreProductoDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Nombre del Producto" />

                    <!-- ERROR AL CARGAR PRODUCTOS -->
                    <TextView
                        android:id="@+id/tvErrorProductosDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/color_error"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Error al cargar productos" />

                    <Button
                        android:id="@+id/btnReintentarProductosDetalle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/btn_reintentar"
                        android:visibility="gone" />

                    <!-- AVISO PUESTO SIN PRODUCTOS -->
                    <TextView
                        android:id="@+id/tvSinProductosDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/sin_productos_comerciante"
                        android:textColor="@color/color_texto"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvContadorFotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_texto"
                        android:textSize="13sp"
                        tools:text="1 de 3" />

                    <!-- DESCRIPCIÓN -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/etiqueta_descripcion"
                        android:textColor="@color/color_texto"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDescripcionDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_texto"
                        android:textSize="14sp"
                        tools:text="Ropa de varón fardo abierto tallas desde M hasta XL" />

                    <!-- PRECIO -->
                    <TextView
                        android:id="@+id/tvPrecioDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Precio: 50 Bs" />

                    <!-- DISPONIBLE -->
                    <TextView
                        android:id="@+id/tvDisponibleDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/color_texto"
                        android:textSize="14sp"
                        tools:text="Disponible: Sí" />

                    <!-- BOTÓN UNIFICADO TRAZAR RUTA -->
                    <Button
                        android:id="@+id/btnTrazarRuta"
                        style="@style/estilo_boton_principal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/trazar_ruta" />

                </LinearLayout>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA RESULTADO / DETALLE RÁPIDO PUESTO (OVERLAY) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaPuesto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgPuesto"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/descripcion_imagen_puesto"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_puesto_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreProductoTarjeta"
                        style="@style/estilo_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        tools:text="Ropa de Varón" />

                    <TextView
                        android:id="@+id/tvDescripcionPuestoTarjeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/color_texto"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Descripción del puesto de prueba" />

                    <TextView
                        android:id="@+id/tvPrecioProductoTarjeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_texto"
                        android:textSize="14sp"
                        tools:text="Precio: 50 Bs" />

                    <Button
                        android:id="@+id/btnVerMas"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="0dp"
                        android:text="@string/ver_mas"
                        android:textColor="@color/color_primario"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCerrarTarjeta"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descripcion_cerrar"
                    android:src="@drawable/ic_cerrar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BARRA INFERIOR FIJA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/barraInferior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- IZQUIERDA: BOTÓN DE MENÚ -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descripcion_menu"
                    android:src="@drawable/ic_menu_hamburguesa"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- CENTRO: BOTÓN MI UBICACIÓN Y INTERRUPTOR -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/contenedorZoom"
                    app:layout_constraintStart_toEndOf="@id/btnMenu"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnMiUbicacion"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/descripcion_mi_ubicacion"
                        android:src="@drawable/ic_mira_ubicacion" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/etiqueta_ubicacion"
                            android:textColor="@color/color_texto"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchUbicacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DERECHA: BOTONES DE ACERCAR Y ALEJAR APILADOS -->
                <LinearLayout
                    android:id="@+id/contenedorZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnAcercar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/descripcion_acercar"
                        android:src="@drawable/ic_mas" />

                    <ImageButton
                        android:id="@+id/btnAlejar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/descripcion_alejar"
                        android:src="@drawable/ic_menos" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL SLIDING NAV VIEW -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start">

        <include
            android:id="@+id/includeMenuLateral"
            layout="@layout/menu_lateral" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
