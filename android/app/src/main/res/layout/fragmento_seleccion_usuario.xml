<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/estilo_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selección de Usuario" />

    <Button
        android:id="@+id/btnIrAConsumidor"
        style="@style/estilo_boton_principal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Modo Consumidor" />

    <Button
        android:id="@+id/btnIrARegistroComerciante"
        style="@style/estilo_boton_principal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Modo Comerciante" />

</LinearLayout>
