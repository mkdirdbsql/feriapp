<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.comerciante.FragmentoInicioComerciante">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- BARRA SUPERIOR (MOSTRADA SOLO EN ESTADO CON PUESTO) -->
        <LinearLayout
            android:id="@+id/layoutBarraSuperior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                style="@style/estilo_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold|italic" />
        </LinearLayout>

        <!-- CONTENEDOR FILTROS DE CATEGORÍAS VECINAS (CON PUESTO Y PRODUCTOS) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contenedorFiltrosCategorias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBarraSuperior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_ver_puestos_con"
                    android:textColor="@color/color_texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacing="6dp"
                        app:singleLine="true" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MAPA (CENTRO) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/contenedorMapa"
            android:name="com.feriapp.app.ui.common.FragmentoMapa"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBarraSuperior" />

        <!-- INDICADOR ESTADO BÚSQUEDA UBICACIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tvEstadoUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="@id/contenedorMapa"
            app:layout_constraintStart_toStartOf="@id/contenedorMapa"
            app:layout_constraintTop_toTopOf="@id/contenedorMapa">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/buscando_tu_ubicacion"
                    android:textColor="@color/color_texto"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- INDICADOR CARGANDO PERFIL -->
        <ProgressBar
            android:id="@+id/indicadorCargandoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/contenedorMapa"
            app:layout_constraintEnd_toEndOf="@id/contenedorMapa"
            app:layout_constraintStart_toStartOf="@id/contenedorMapa"
            app:layout_constraintTop_toTopOf="@id/contenedorMapa" />

        <!-- TARJETA DE ERROR EN MAPA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toBottomOf="@id/contenedorMapa"
            app:layout_constraintEnd_toEndOf="@id/contenedorMapa"
            app:layout_constraintStart_toStartOf="@id/contenedorMapa"
            app:layout_constraintTop_toTopOf="@id/contenedorMapa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvMensajeError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/color_error"
                    android:textSize="15sp"
                    tools:text="Error al cargar el perfil" />

                <Button
                    android:id="@+id/btnReintentar"
                    style="@style/estilo_boton_principal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_reintentar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GLOBO DE AYUDA PARA AGREGAR PRODUCTO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/globoAgregarProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/tarjetaMiPuesto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/globo_agregar_producto_texto"
                android:textColor="@color/color_texto"
                android:textSize="13sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA FIJA "PUESTO VECINO" (ESTADO CON PUESTO Y MARCADOR VECINO SELECCIONADO) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaVecino"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPuestoVecino"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/descripcion_imagen_puesto"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_puesto_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombrePuestoVecino"
                        style="@style/estilo_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textSize="16sp"
                        tools:text="Puesto Vecino" />

                    <LinearLayout
                        android:id="@+id/contenedorProductosVecino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCerrarVecino"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descripcion_cerrar"
                    android:src="@drawable/ic_cerrar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA FIJA "MI PUESTO" (ESTADO CON PUESTO) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaMiPuesto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPuestoMio"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/descripcion_imagen_puesto"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_puesto_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombrePuestoMio"
                        style="@style/estilo_titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textSize="16sp"
                        tools:text="Mi Puesto de Ropa" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEditarPuesto"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_editar_puesto"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnEditarProductos"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_editar_productos"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BARRA INFERIOR FIJA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/barraInferior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- IZQUIERDA: BOTÓN DE MENÚ -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descripcion_menu"
                    android:src="@drawable/ic_menu_hamburguesa"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- CENTRO: BLOQUE BOTÓN AGREGAR Y CONTADOR -->
                <LinearLayout
                    android:id="@+id/contenedorAgregar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnAgregar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_boton_circulo_comerciante"
                        android:contentDescription="@string/etiqueta_agregar_puesto"
                        android:elevation="4dp"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mas"
                        app:tint="@color/color_fondo" />

                    <TextView
                        android:id="@+id/tvEtiquetaAgregar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/etiqueta_agregar_puesto"
                        android:textColor="@color/color_texto"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvContadorProductos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/color_texto"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="0 / 3" />
                </LinearLayout>

                <!-- BOTÓN CENTRAR UBICACIÓN A LA DERECHA DEL BLOQUE AGREGAR -->
                <ImageButton
                    android:id="@+id/btnCentrarUbicacion"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descripcion_mi_ubicacion"
                    android:src="@drawable/ic_mira_ubicacion"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/contenedorAgregar"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- DERECHA: BOTONES DE ACERCAR Y ALEJAR APILADOS -->
                <LinearLayout
                    android:id="@+id/contenedorZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnAcercar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/descripcion_acercar"
                        android:src="@drawable/ic_mas" />

                    <ImageButton
                        android:id="@+id/btnAlejar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/descripcion_alejar"
                        android:src="@drawable/ic_menos" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL SLIDING NAV VIEW -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start">

        <include
            android:id="@+id/includeMenuLateral"
            layout="@layout/menu_lateral" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
